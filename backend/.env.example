APP_NAME=CounselAI Legal Document Analysis
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/legal_analysis.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173

MAX_FILES_PER_UPLOAD=100
MAX_FILE_SIZE_MB=50
MAX_TOTAL_UPLOAD_SIZE_MB=500

# Use https://ollama.com for direct Ollama Cloud API access, or localhost for local Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_MAP_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text
ENABLE_EMBEDDINGS=false
OLLAMA_API_KEY=

# For an OpenAI-compatible provider such as OpenAI/Groq
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini

CHUNK_SIZE=7000
CHUNK_OVERLAP=500
MAP_BATCH_SIZE=4
MAX_CONTEXT_CHARS_PER_BATCH=7000
MAX_REDUCE_CHARS_PER_BATCH=45000
